# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Ignore Python bytecode from the markdown generators
__pycache__/
*.pyc

# assets/js/main.min.js is committed on purpose. GitHub's built-in Pages
# build does not run the uglify step, so the file has to be in the repo
# or the live site 404s it. The Actions workflow still regenerates it.
